{
  "name": "witful-documentation-checks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "check": "node check-markdown.mjs",
    "test": "node --test check-markdown.test.mjs ../ci/coverage.test.mjs native-codec.test.mjs lint-markdown.test.mjs",
    "lint": "cd ../.. && node scripts/documentation/node_modules/eslint/bin/eslint.js --config scripts/documentation/eslint.config.mjs scripts/documentation scripts/ci services/codegraph",
    "markdown:lint": "node lint-markdown.mjs",
    "format:check": "prettier --config prettier.json --check ../../README.md",
    "format": "prettier --config prettier.json --write ../../README.md"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cbor2": "2.4.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "katex": "0.19.0",
    "markdownlint": "0.42.0",
    "mermaid": "12.2.0",
    "prettier": "3.9.10",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  }
}
